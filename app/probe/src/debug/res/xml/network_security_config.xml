<?xml version="1.0" encoding="utf-8"?>
<!-- 仅 debug 变体引用（src/debug/AndroidManifest.xml）：允许对仿真服务器的明文流量。
     只对已知联调地址按 domain-config 放行，不用 base-config 全局放行（收窄 MITM 面）。
     注意：<domain> 条目只支持具体域名/IP，不支持网段（如 192.168.0.0/16）——
     真机联调时请按实际服务器 IP 在此增补条目（如 <domain>192.168.1.100</domain>）。 -->
<network-security-config>
    <domain-config cleartextTrafficPermitted="true">
        <!-- Android 模拟器指向宿主机 -->
        <domain includeSubdomains="false">10.0.2.2</domain>
        <!-- 本机回环（adb reverse 场景） -->
        <domain includeSubdomains="false">127.0.0.1</domain>
    </domain-config>
</network-security-config>
