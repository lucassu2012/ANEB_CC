<?xml version="1.0" encoding="utf-8"?>
<!-- debug 变体的网络安全配置。

     ⚠ **NSC 是整份资源覆盖、不是合并**：本文件存在时，`src/main` 的同名文件对 debug
     构建**完全失效**。因此 main 版里的 E-01 bare-IP 段必须在本文件里**重复一份**，
     否则 debug 构建会丢掉 `aneb_ip_ca` 锚、连不上 SNI-RST 旁路通道（D-22/D-25）。
     两份保持同步；改一处必须改另一处（收窄口径见 main 版注释与 D-500③）。

     本文件相对 main 版**多出**的部分：模拟器/回环的**明文**联调段（debug only）。 -->
<network-security-config>
    <!-- debug 专属：模拟器宿主机与本机回环的明文联调（release 无此段） -->
    <domain-config cleartextTrafficPermitted="true">
        <!-- Android 模拟器指向宿主机 -->
        <domain includeSubdomains="false">10.0.2.2</domain>
        <!-- 本机回环（adb reverse 场景） -->
        <domain includeSubdomains="false">127.0.0.1</domain>
        <trust-anchors>
            <!-- 本地自签联调 CA（debug only，P2-C05：SAN=IP:10.0.2.2/IP:127.0.0.1/DNS:localhost） -->
            <certificates src="@raw/aneb_local_ca" />
            <!-- 保留系统锚：同地址将来换正规证书不需改配置 -->
            <certificates src="system" />
        </trust-anchors>
    </domain-config>

    <!-- ↓↓↓ 与 src/main 版**逐字相同**的一段（因整份覆盖语义必须重复，见文件头） ↓↓↓
         E-01 bare-IP 通道：自签 IP-SAN 证书，SNI-RST 旁路落点（R-33/D-22/D-25）。
         日落条款：E-06 公共 CA 落地后与 main 版一同撤除私有锚（D-500③）。 -->
    <domain-config cleartextTrafficPermitted="false">
        <domain includeSubdomains="false">120.79.148.0</domain>
        <trust-anchors>
            <certificates src="@raw/aneb_ip_ca" />
            <certificates src="system" />
        </trust-anchors>
    </domain-config>
    <!-- T54（D-703）：设备经真 WiFi 连 PC 上的 C 树 server。锚＝gencert -mode=ip -ip 10.10.3.119
         生成的自签 IP-SAN 证书（私钥在仓外 E:/tools/aneb-ctree/tls，不入库）。作用域钉死单个 LAN IP，
         明文不放行。⚠ 该 IP 是酒店 DHCP 所分，换网即失效——届时重跑 gencert 并替换 raw/aneb_lan_ca.pem。 -->
    <domain-config cleartextTrafficPermitted="false">
        <domain includeSubdomains="false">10.10.3.119</domain>
        <trust-anchors>
            <certificates src="@raw/aneb_lan_ca" />
            <certificates src="system" />
        </trust-anchors>
    </domain-config>
</network-security-config>
