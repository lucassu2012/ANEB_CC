<?xml version="1.0" encoding="utf-8"?>
<!-- Profile 3 适配器宿主：无障碍观察打点配置（观察模式 only，AnebAccessibilityService KDoc）。
     - eventTypes 最小订阅：窗口内容变化 / 文本变化（打点源）+ 窗口状态变化（会话分段信号）
       + 视图点击 typeViewClicked（send-anchor v2 发送按钮点击锚点，被动观察收到非注入）；
     - canRetrieveWindowContent=true：包名/事件元数据观察所需（不读取、不存储文本内容）；
     - notificationTimeout=0：不叠加系统事件节流（节奏代理保真；回调侧 R-16 纪律见 KDoc）；
     - 不声明 canPerformGestures / 不请求任何操作能力——观察模式在配置层钉死。 -->
<accessibility-service xmlns:android="http://schemas.android.com/apk/res/android"
    android:description="@string/adapter_obs_service_description"
    android:accessibilityEventTypes="typeWindowContentChanged|typeViewTextChanged|typeWindowStateChanged|typeViewClicked"
    android:accessibilityFeedbackType="feedbackGeneric"
    android:accessibilityFlags="flagDefault"
    android:canRetrieveWindowContent="true"
    android:notificationTimeout="0" />
