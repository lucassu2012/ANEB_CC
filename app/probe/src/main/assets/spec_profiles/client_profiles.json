{
  "schema_version": "1.0.0",
  "profiles": [
    {
      "id": "token_experience",
      "displayName": "Token 体验",
      "tagline": "AI 流式交互取证 → AQS 分",
      "business": "从真实 AI 交互视角评估体验：首字快不快、吐字稳不稳、卡顿多不多——直接对应“用起来爽不爽”。",
      "metrics": [
        { "name": "Token 速率", "unit": "tok/s", "dynamic": false },
        { "name": "字间时延 ITL", "unit": "ms", "dynamic": true },
        { "name": "首字时延 TTFT", "unit": "ms", "dynamic": false },
        { "name": "卡顿", "unit": "次", "dynamic": true }
      ],
      "conclusion": "多场景 KPI 加权 → AQS 分与分级（优/良/可/差）+ 取证明细视图。",
      "version": "token-profile@0.4.0",
      "businessType": {
        "summary": "用户在 kimi/deepseek/qwen 对话框的多模态互动——上行 KB 文本、MB 文档、10MB 图、100MB 视频（大小可调、可多次）；下行返回文本/文档/图片/视频。ANEB 为模拟（非真实 API 接入），stimulus 由服务端行为模型确定性生成。",
        "subScenarios": [
          {
            "code": "TK-1",
            "title": "纯文本对话",
            "uplink": "KB 文本（~2KB 单次微突发，chunk 2KB）",
            "downlink": "稳态 token 流（40 tps，600 tok）",
            "behaviorHint": ["LOW_LATENCY", "STABILITY"]
          },
          {
            "code": "TK-2",
            "title": "文档理解",
            "uplink": "MB 文档（0.5–5MB，可多次，chunk 64KB）",
            "downlink": "结构化摘要流（40–60 tps）",
            "behaviorHint": ["UPLINK_BURST", "LOW_LATENCY"]
          },
          {
            "code": "TK-3",
            "title": "图片多模态",
            "uplink": "10MB 图（上下行交替，可多次）",
            "downlink": "视觉分析代码流（40 tps，200 tok×N）",
            "behaviorHint": ["UPLINK_BURST", "STABILITY"]
          },
          {
            "code": "TK-4",
            "title": "视频多模态",
            "uplink": "100MB 视频（持续大流，单次可调）",
            "downlink": "文本流可夹图/视频返回",
            "behaviorHint": ["UPLINK_BURST", "STABILITY"]
          },
          {
            "code": "TK-5",
            "title": "下行大对象",
            "uplink": "KB 触发指令",
            "downlink": "10–100MB 图/视频 bulk（走 /download，纳入 D1）",
            "behaviorHint": ["DOWNLINK_BANDWIDTH"]
          },
          {
            "code": "TK-6",
            "title": "编码 Agent",
            "uplink": "MB prompt(512KB) + 工具上行 8KB×8",
            "downlink": "突发簇代码流(100tps，簇间 pause) + 工具下行 2KB×8",
            "behaviorHint": ["LOW_LATENCY", "UPLINK_BURST", "STABILITY"]
          }
        ]
      },
      "metricSpecs": [
        {
          "id": "T1",
          "name": "首Token时延 TTFT",
          "unit": "ms",
          "group": "T",
          "definition": "prompt 末字节 → 首 token 首字节，减服务端已知注入 dwell（network-only 口径进 AQS）",
          "direction": "LOWER_BETTER",
          "target": { "excellent": 200.0, "good": 500.0, "fair": 1000.0, "poorFloor": 3000.0, "slaPercentile": 0.95, "slaTargetLevel": "GOOD", "perPayloadBand": null },
          "measurability": "MEASURABLE",
          "scored": true,
          "anchorRef": "T1_ANCHORS"
        },
        {
          "id": "T2",
          "name": "字间时延 ITL P95",
          "unit": "ms",
          "group": "T",
          "definition": "校正 ITL=相邻到达间隔−flush 间隔+名义间隔，剔合帧伪 0 与 resume",
          "direction": "LOWER_BETTER",
          "target": { "excellent": 100.0, "good": 200.0, "fair": 400.0, "poorFloor": 1200.0, "slaPercentile": 0.95, "slaTargetLevel": "GOOD", "perPayloadBand": null },
