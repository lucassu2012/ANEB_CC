+++ b/scripts/tests/test_decompose_2x_roundtrip.py
@@ -0,0 +1,239 @@
+# -*- coding: utf-8 -*-
+"""终审 V4 §2-11 ＋ §8-17：`T` 的前提是**往返**，不是「发了」；超时必须当场印。
+
+🔴 §2-11：原实现 `T` 只取「已发送」⇒ 发了 20 个、一个没过去也得 `T=20`；第一道门只在
+preflight 跑一次，其后 12 格约 6 分钟没有任何往返复查 ⇒ 设备掉线后每格读 0，
+而那个 0 会被读成「转发层看不见转发包」。
+🔴 §8-17：`run()` 把 `TimeoutExpired` 与别的异常一起吞掉、从不印 ⇒ 180 s 静默等待，
+事后证据里没有一行说原因是超时。
+
+本文件的门**两个方向都钉**：有往返 ⇒ 必须给 `T`（部分丢包照给，`T` 取已发送）；
+没往返（0 收／收数读不到／发包数读不到／超时）⇒ 必须拒给并说出是哪一种；
+连续两个打包格没往返 ⇒ `main()` 必须中止**且照常收尾**；只断一格 ⇒ 不得中止。
+
+全部零参（`run_all.py` 以 `fn()` 调用，不支持 fixture）；打桩一律 try/finally 还原。
+"""
+import contextlib
+import io
+import os
+import re
+import subprocess
+import sys
+
+_DIAG = os.path.join(os.path.dirname(os.path.dirname(os.path.abspath(__file__))), "diag")
+if _DIAG not in sys.path:
+    sys.path.insert(0, _DIAG)
+
+import decompose_2x_probe as P                                       # noqa: E402
+from decompose_2x_probe import ping_roundtrip, roundtrip_streak       # noqa: E402
+
+TGT = P.TARGET
+
+PC_ZH_OK = ("正在 Ping %s 具有 32 字节的数据:\n" % TGT
+            + "".join("来自 %s 的回复: 字节=32 时间=12ms TTL=116\n" % TGT for _ in range(20))
+            + "\n%s 的 Ping 统计信息:\n    数据包: 已发送 = 20，已接收 = 20，丢失 = 0 (0%% 丢失)，\n"
+            % TGT)
+# Windows 的已知行为：网关回的「无法访问目标主机」也记作 Received。
+PC_EN_UNREACH = ("Pinging %s with 32 bytes of data:\n" % TGT
+                 + "".join("Reply from 192.168.1.1: Destination host unreachable.\n"
+                           for _ in range(20))
+                 + "\nPing statistics for %s:\n    Packets: Sent = 20, Received = 20, "
+                   "Lost = 0 (0%% loss),\n" % TGT)
+PC_EN_TIMEOUT = ("Pinging %s with 32 bytes of data:\n" % TGT
+                 + "Request timed out.\n" * 20
+                 + "\nPing statistics for %s:\n    Packets: Sent = 20, Received = 0, "
+                   "Lost = 20 (100%% loss),\n" % TGT)
+
+
+def _dev(sent, recv, errors=None):
+    tail = ", +%d errors" % errors if errors else ""
+    return ("PING %s (%s) 56(84) bytes of data.\n" % (TGT, TGT)
+            + "".join("64 bytes from %s: icmp_seq=%d ttl=116 time=12.3 ms\n" % (TGT, i + 1)
+                      for i in range(recv))
+            + "\n--- %s ping statistics ---\n%d packets transmitted, %d received%s, "
+              "%d%% packet loss, time 19027ms\n"
+            % (TGT, sent, recv, tail, 100 * (sent - recv) // sent))
+
+
+@contextlib.contextmanager
+def _patched(obj, **attrs):
+    orig = {k: getattr(obj, k) for k in attrs}
+    for k, v in attrs.items():
+        setattr(obj, k, v)
+    try:
+        yield
+    finally:
+        for k, v in orig.items():
+            setattr(obj, k, v)
+
+
+# ---------- ping_roundtrip：纯函数 ----------
+
+def test_pc_echo_replies_give_T_equal_to_sent():
+    r = ping_roundtrip("pc", PC_ZH_OK, "")
+    assert (r["sent"], r["recv"], r["T"]) == (20, 20, 20), r
+
+
+def test_pc_unreachable_that_windows_counts_as_received_is_not_a_roundtrip():
+    """🔴 摘要行写着「Received = 20」——照它读就是往返成立。那 20 个全是网关回的差错。"""
+    assert re.search(r"Received = 20", PC_EN_UNREACH), "夹具必须复现 Windows 的那个假收数"
+    r = ping_roundtrip("pc", PC_EN_UNREACH, "")
+    assert r["recv"] == 0 and r["T"] is None, r
+    assert "20 发 0 收" in r["why"], r["why"]
+
+
+def test_pc_echo_lines_from_another_host_are_not_a_roundtrip_to_the_target():
+    other = ("Pinging %s with 32 bytes of data:\n" % TGT
+             + "Reply from 10.9.9.9: bytes=32 time=1ms TTL=64\n" * 20
+             + "\nPing statistics for %s:\n    Packets: Sent = 20, Received = 20, "
+               "Lost = 0 (0%% loss),\n" % TGT)
+    r = ping_roundtrip("pc", other, "")
+    assert r["recv"] == 0 and r["T"] is None, r
+
+
+def test_pc_all_timeouts_refuse_T():
+    r = ping_roundtrip("pc", PC_EN_TIMEOUT, "")
+    assert (r["sent"], r["recv"], r["T"]) == (20, 0, None), r
+
+
+def test_partial_loss_still_gives_T_as_sent_not_recv():
+    """§3：`T` 取**已发送**；收数只作前提。20 发 3 收 ⇒ `T=20`，不是 3。"""
+    r = ping_roundtrip("dev", _dev(20, 3), "")
+    assert (r["recv"], r["T"]) == (3, 20), r
+
+
+def test_dev_zero_received_refuses_T_and_says_so():
+    r = ping_roundtrip("dev", _dev(20, 0, errors=20), "")
+    assert (r["sent"], r["recv"], r["T"]) == (20, 0, None), r
+    assert "本格往返 20 发 0 收" in r["why"], r["why"]
+
+
+def test_dev_all_received_gives_T():
+    r = ping_roundtrip("dev", _dev(20, 20), "")
+    assert (r["sent"], r["recv"], r["T"]) == (20, 20, 20), r
+
+
+def test_recv_unreadable_is_not_zero_and_not_a_roundtrip():
+    """发包数读得到、收数读不到 ⇒ `recv` 是 None 不是 0，且拒给 T——两种缺席分开说。"""
+    r = ping_roundtrip("dev", "20 packets transmitted, garbled", "")
+    assert r["sent"] == 20 and r["recv"] is None and r["T"] is None, r
+    assert "收数读不到" in r["why"], r["why"]
+
+
+def test_sent_unreadable_carries_the_err_text_forward():
+    """超时后 `run()` 回 `(None, '', '超时：180s')` ⇒ 缺席的**原因**要进说明，不只是「无摘要行」。"""
+    r = ping_roundtrip("dev", "", "超时：180s")
+    assert r["sent"] is None and r["T"] is None, r
+    assert "超时：180s" in r["why"], r["why"]
+
+
+# ---------- run()：超时单独接、当场印 ----------
+
+def test_run_prints_timeout_and_returns_a_distinct_err():
+    def boom(*a, **k):
+        raise subprocess.TimeoutExpired(cmd=a[0], timeout=k.get("timeout"))
+    buf = io.StringIO()
+    with _patched(P.subprocess, run=boom), contextlib.redirect_stdout(buf):
+        rc, out, err = P.run(["adb.exe", "shell", "ping"], timeout=180)
+    assert (rc, out) == (None, "") and err == "超时：180s", (rc, out, err)
+    assert "超时 180s" in buf.getvalue(), "超时必须当场印出来：%r" % buf.getvalue()
+
+
+def test_run_other_failures_keep_their_old_shape():
+    def boom(*a, **k):
+        raise FileNotFoundError("no adb")
+    buf = io.StringIO()
+    with _patched(P.subprocess, run=boom), contextlib.redirect_stdout(buf):
+        rc, out, err = P.run(["adb.exe"], timeout=5)
+    assert rc is None and err.startswith("调用失败："), err
+    assert "超时" not in buf.getvalue()
+
+
+# ---------- pc_ping／dev_ping：零参照旧可调，带 acq 时回填 ----------
+
+def test_ping_helpers_fill_acq_and_print_the_reason():
+    buf = io.StringIO()
+    acq = {}
+    with _patched(P, run=lambda *a, **k: (1, _dev(20, 0, errors=20), "")), \
+            contextlib.redirect_stdout(buf):
+        t = P.dev_ping(acq)
+        t0 = P.dev_ping()
+    assert t is None and t0 is None
+    assert acq["T"] is None and acq["recv"] == 0, acq
+    assert "本格往返 20 发 0 收" in buf.getvalue(), buf.getvalue()
+
+
+# ---------- roundtrip_streak ----------
+
+def test_streak_idle_cells_neither_count_nor_reset():
+    bad, good = {"T": None, "why": "x"}, {"T": 20, "why": "y"}
+    s = 0
+    for acq in (bad, None, {}, bad):
+        s = roundtrip_streak(s, acq)
+    assert s == 2, "空闲格插在两格断之间不得把连续数洗掉"
+    assert roundtrip_streak(s, good) == 0
+
+
+def test_streak_one_blip_between_roundtrips_stays_at_one():
+    bad, good = {"T": None, "why": "x"}, {"T": 20, "why": "y"}
+    s = 0
+    for acq in (bad, good, bad):
+        s = roundtrip_streak(s, acq)
+    assert s == 1
+
+
+# ---------- main()：接线 ----------
+
+def _run_main(dev_outcomes):
+    """PC 格全通；设备格按 `dev_outcomes` 依次给 `(rc, out, err)`。→ (结果或异常, 跑过的格, 收尾次数, stdout)。"""
+    ran, torn = [], []
+    dev = list(dev_outcomes)
+
+    def fake_run(args, timeout=180):
+        if args[0] == "ping.exe":
+            return (0, PC_ZH_OK, "")
+        return dev.pop(0)
+
+    def fake_cell(d, label, layer, filt, traffic, filt_b=None, opened=None):
+        ran.append(label.split()[0])
+        return {"label": label, "layer": layer, "T": traffic(), "count": 0}
+
+    pre_tuple = (None, {"hot_ifidx": 7}, "dsrc", 1060, False, "fb", "fu", "fh", "fs", "fn",
+                 "fi", "fx", "ft", 0)
+    buf = io.StringIO()
+    res = None
+    with _patched(P, run=fake_run, cell=fake_cell, preflight=lambda: pre_tuple,
+                  report_cell=lambda c: None, no_traffic=lambda s: 0,
+                  derive_constants=lambda: {"hot_ifidx": 7},
+                  constants_verdict=lambda k, s: (True, "ok"),
+                  teardown=lambda any_, pre: torn.append((any_, pre))), \
+            contextlib.redirect_stdout(buf):
+        try:
+            res = P.main()
+        except SystemExit as e:
+            res = e
+    return res, ran, torn, buf.getvalue()
+
+
+def test_main_aborts_on_second_consecutive_dead_ping_cell_and_still_tears_down():
+    """C1 0 收、F1 adb 超时 ⇒ 在 F1 之后中止；F2/N1/N2 不跑；收尾照做一次。"""
+    res, ran, torn, out = _run_main([(1, _dev(20, 0, errors=20), ""),
+                                     (None, "", "超时：180s")])
+    assert isinstance(res, SystemExit), "连续两格没往返必须中止，得 %r" % (res,)
+    msg = str(res.code)
+    assert msg.startswith("NOT_EXECUTED") and "[F1" in msg and "超时：180s" in msg, msg
+    assert ran[-1] == "F1" and "F2" not in ran and "N2" not in ran, ran
+    assert len(torn) == 1, "中止也必须走收尾：%r" % torn
+
+
+def test_main_single_blip_does_not_abort_and_attaches_acq():
+    res, ran, torn, out = _run_main([(1, _dev(20, 0, errors=20), ""), (0, _dev(20, 20), ""),
+                                     (1, _dev(20, 0, errors=20), ""), (0, _dev(20, 19), ""),
+                                     (0, _dev(20, 20), "")])
+    assert isinstance(res, tuple), "断一格不得中止，得 %r" % (res,)
+    cells = res[0]
+    assert ran[-1] == "N2", ran
+    assert cells["C1"]["T"] is None and cells["C1"]["acq"]["recv"] == 0, cells["C1"]
+    assert cells["F1"]["T"] == 20 and cells["N1"]["acq"]["recv"] == 19, cells["N1"]
+    assert cells["S1"]["acq"] is None, "空闲格没有往返读数，acq 必须是 None 而不是空 dict"
+    assert len(torn) == 1
