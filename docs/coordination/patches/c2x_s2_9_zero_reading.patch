+def cell_status(count, shutting_down, thread_exited, exited_before_traffic):
+    """→ `(ok, why)`。§1.1-6 全格通则的**可消费**形态（终审 V4 §2-9／§8-5）。
+
+    🔴 `zero_reading_ok` 本身没错,错的是它的输入:原实现在主线程 `finally` 里**无条件**
+    `shutting_down = True`,读线程从不采样它 ⇒ 判定时恒真 ⇒ 「真零」与「读线程开跑即死」
+    在所有被判字段上逐字相同,`zero_reading_ok(0, True, True)` 恒得「这个 0 成立」。
+    现 `shutting_down` 取**读线程在 Recv 失败那一瞬自己看到的** stop 旗标(主线程在 Shutdown
+    **之前** set)⇒ 读线程自己死掉时它看到的是 False ⇒ 本函数判 NOT_EXECUTED。
+
+    `exited_before_traffic` ⇒ 该格从未在窗口内读过包 ⇒ **无论计数多少**都 NOT_EXECUTED
+    (计数非 0 也不行:那是窗口外的包)。
+    ⚠ 本函数**只**把 §1.1-6 那条零读数通则做成可消费的;「读线程窗口中途自己死掉、
+    计数非 0 但偏少」**不在本条范围**(计数非 0 时本通则不适用),另立条目再议。
+    """
+    if count is None:
+        return (False, "句柄没开成 ⇒ NOT_EXECUTED")
+    if exited_before_traffic:
+        return (False, "读线程在流量开始之前就已退出(计数 %s)⇒ 该格从未在窗口内读过包 "
+                       "⇒ NOT_EXECUTED" % (count,))
+    return zero_reading_ok(count, shutting_down, thread_exited)
+
+
