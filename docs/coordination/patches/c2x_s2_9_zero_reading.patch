+def _valid_cell(**kw):
+    c = {"count": 20, "count_b": None, "shutting_down": True, "shutting_down_b": None,
+         "thread_exited": True, "thread_exited_b": None,
+         "exited_before_traffic": False, "exited_before_traffic_b": None,
+         "T": 20, "window_s": 3.0, "same_window": True, "recs": [], "recs_b": [],
+         "buckets": None,
+         "summary": {"n_distinct_keys": 20, "multiplicity_hist": {1: 20},
+                     "src_same_within_key": True}}
+    c.update(kw)
+    return c
+
+
+def _s3_pass_cells():
+    """impostor 先查 §1.6 S3 自证，未过即整节 VOID_S3、走不到分子 ⇒ 要测分子就得先让 S3 过。"""
+    seq = [{"icmp_seq": i} for i in range(20)]
+    return {n: _valid_cell(recs=list(seq), recs_b=list(seq), count_b=20, shutting_down_b=True,
+                           thread_exited_b=True, exited_before_traffic_b=False)
+            for n in ("S3a", "S3b")}
+
+
+def _run(cells):
+    buf = io.StringIO()
+    with contextlib.redirect_stdout(buf):
+        P.apply_verdicts(cells)
+    return buf.getvalue()
+
