@@ -0,0 +1,308 @@
+# -*- coding: utf-8 -*-
+"""终审 V4 §2-9／§8-5：零读数通则的判别量不得是常量。
+
+🔴 原实现在 `cell()` 的 `finally` 里**无条件** `shutting_down = True`，读线程从不采样它
+⇒ 判定时恒真 ⇒ 「真零」与「读线程开跑即死」在所有被判字段上逐字相同，
+`zero_reading_ok(0, True, True)` 恒得「这个 0 成立」——**房规「零必须与仪器从未跑过可分」
+由一个不可能失败的检查满足**。
+
+本文件的门**两个方向都钉**（承审阅原文「门两个方向都要」）：
+- 世界 A：读线程在第一次 Recv 就自己死掉 ⇒ 必须 NOT_EXECUTED；
+- 世界 B：读线程一直阻塞到被 Shutdown 叫停、计数 0 ⇒ 这个 0 **必须**成立。
+另钉「stop 旗标在 Shutdown **之前** set」这个顺序：假驱动的 Shutdown 放行读线程后
+故意慢返回，顺序一反，世界 B 就**确定性**变红，不靠竞态碰运气。
+
+全部零参（`run_all.py` 以 `fn()` 调用，不支持 fixture）；打桩一律 try/finally 还原。
+Linux 上无 `ctypes.get_last_error`，本文件临时补一个；Windows 上临时替换后还原。
+"""
+import contextlib
+import ctypes
+import io
+import os
+import sys
+import threading
+import time
+
+_DIAG = os.path.join(os.path.dirname(os.path.dirname(os.path.abspath(__file__))), "diag")
+if _DIAG not in sys.path:
+    sys.path.insert(0, _DIAG)
+
+import decompose_2x_probe as P                                       # noqa: E402
+from decompose_2x_verdicts import cell_status, zero_reading_ok       # noqa: E402
+
+ERROR_NO_DATA = 232
+
+
+@contextlib.contextmanager
+def _patched(grace=0.0):
+    """临时：GRACE_S＝grace；`ctypes.get_last_error` 返回 232。退出即还原。"""
+    had = hasattr(ctypes, "get_last_error")
+    orig_gle = getattr(ctypes, "get_last_error", None)
+    orig_grace = P.GRACE_S
+    ctypes.get_last_error = lambda: ERROR_NO_DATA
+    P.GRACE_S = grace
+    try:
+        yield
+    finally:
+        P.GRACE_S = orig_grace
+        if had:
+            ctypes.get_last_error = orig_gle
+        else:
+            del ctypes.get_last_error
+
+
+class _DiesAtFirstRecv(object):
+    """世界 A：句柄开成，但第一次 Recv 就 FALSE——与 Shutdown 无关（ifIdx 漂了之类）。"""
+
+    def WinDivertOpen(self, *a):
+        return 4242
+
+    def WinDivertRecv(self, *a):
+        return False
+
+    def WinDivertShutdown(self, *a):
+        return True
+
+    def WinDivertClose(self, *a):
+        return True
+
+
+class _BlocksUntilShutdown(object):
+    """世界 B：Recv 一直阻塞，直到 Shutdown 才 FALSE（真零的形状）。
+
+    🔴 Shutdown **放行读线程之后故意慢 0.2s 才返回**：若实现把 `stop.set()` 挪到 Shutdown
+    之后，读线程必在那 0.2s 里醒来并采到 False ⇒ 本世界确定性变红。
+    `dies` 里的句柄走世界 A（用于「a 真零、b 自己死」的混合格）。
+    """
+
+    def __init__(self, dies=()):
+        self._released = threading.Event()
+        self._dies = set(dies)
+        self._n = 0
+
+    def WinDivertOpen(self, *a):
+        self._n += 1
+        return 1000 + self._n                 # a＝1001，b＝1002
+
+    def WinDivertRecv(self, h, *a):
+        if h in self._dies:
+            return False
+        self._released.wait(10)
+        return False
+
+    def WinDivertShutdown(self, *a):
+        self._released.set()
+        time.sleep(0.2)
+        return True
+
+    def WinDivertClose(self, *a):
+        return True
+
+
+def _traffic_slow():
+    time.sleep(0.3)                           # 给世界 A 的读线程充足时间在 stop 之前自己死掉
+    return 20
+
+
+# ─────────────────────────── 纯函数 cell_status ───────────────────────────
+
+def test_true_zero_still_holds():
+    """🔴 反方向：真零（读线程被叫停时看到 stop＝True、已退出、非先于流量）必须成立。
+    否则一个恒 NOT_EXECUTED 的实现也能过本文件的其余门。"""
+    ok, why = cell_status(0, True, True, False)
+    assert ok is True, why
+    assert "这个 0 成立" in why, why
+
+
+def test_reader_died_on_its_own_is_not_executed():
+    ok, why = cell_status(0, False, True, False)
+    assert ok is False, why
+    assert "NOT_EXECUTED" in why, why
+
+
+def test_exited_before_traffic_is_not_executed_even_if_nonzero():
+    """先于流量退出 ⇒ 该格从未在窗口内读过包 ⇒ 计数非 0 也不行（那是窗口外的包）。"""
+    ok, why = cell_status(5, True, True, True)
+    assert ok is False, why
+    assert "流量开始之前" in why, why
+
+
+def test_unopened_handle_is_not_executed():
+    assert cell_status(None, None, None, None)[0] is False
+
+
+def test_scope_boundary_nonzero_mid_window_death_is_not_judged_here():
+    """⚠ 钉的是**范围边界**，不是背书：读线程窗口中途自己死掉而计数非 0，
+    本通则（只管 0）不适用 ⇒ 这里仍判 ok。要收紧请另立条目并改本门——
+    改的时候本门会红，逼人意识到自己在扩范围。"""
+    assert cell_status(5, False, True, False)[0] is True
+
+
+def test_the_old_constant_input_is_exactly_what_let_the_dead_reader_through():
+    """史实对照：旧实现喂的是常量 True ⇒ 读线程死掉也得「这个 0 成立」。
+    本门钉住**为什么**输入必须来自读线程，而不是再测一遍新实现。"""
+    assert zero_reading_ok(0, True, True)[0] is True
+    assert zero_reading_ok(0, False, True)[0] is False
+
+
+# ─────────────────────────── cell() 两个世界 ───────────────────────────
+
+def test_world_a_reader_dies_at_first_recv_is_not_executed():
+    """🔴 世界 A：旧实现在这里得 shutting_down=True ⇒「这个 0 成立」。"""
+    with _patched():
