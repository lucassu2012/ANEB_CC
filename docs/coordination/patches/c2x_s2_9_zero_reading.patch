+def test_dead_reader_s1_is_refused_before_any_verdict_not_read_as_no_noise():
+    """🔴 审阅点名的错误归因情景之一：S1 读线程开跑即死、计数 0 ⇒ 旧实现印 §4.6 底噪判词
+    （NOISE_NONE 放行整层）。现在必须先印 NOT_EXECUTED，且**不得**再印 S1 的底噪判词。"""
+    out = _run({"A1": _valid_cell(),
+                "S1": _valid_cell(count=0, shutting_down=False, summary=None)})
+    assert "[S1] NOT_EXECUTED" in out, out
+    assert "§4.6 S1 底噪" not in out, out
+    assert out.index("[S1] NOT_EXECUTED") < out.index("§4.1"), "拒判必须印在任何判词之前"
+
