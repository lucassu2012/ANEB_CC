+class _TaggingDriver(_BlocksUntilShutdown):
+    """在 Recv 里给当前读线程打上它读的句柄号，供受控时钟区分 a／b。"""
+
+    def WinDivertRecv(self, h, *a):
+        threading.current_thread()._fake_h = h
+        return _BlocksUntilShutdown.WinDivertRecv(self, h, *a)
+
+
+def test_handle_b_exited_before_traffic_uses_its_own_exit_time():
+    """🔴 句柄 b 的「先于流量退出」必须拿 **b 自己的**退出时刻比。
+
+    真实时钟下 b 读线程退出与 traffic_start 打戳之间是调度竞态，值不确定 ⇒
+    「错用 a 的时刻」这种接线错只会偶尔被抓。这里用受控时钟把时刻钉死：
+    b 读线程取时＝0、a 读线程取时＝1e9、主线程取时＝500
+    ⇒ 正确实现：exited_before_traffic_b=True、exited_before_traffic=False，**确定性**可分。
+    """
+    real_time = time.time
+
+    def fake_clock():
+        h = getattr(threading.current_thread(), "_fake_h", None)
+        return {1002: 0.0, 1001: 1e9}.get(h, 500.0)
+
+    time.time = fake_clock
+    try:
+        with _patched():
+            c = P.cell(_TaggingDriver(dies=(1002,)), "A1", 0, "true", lambda: 20,
+                       filt_b="true")
+    finally:
+        time.time = real_time
+    assert c["t"]["traffic_start"] == 500.0, c["t"]
+    assert c["t"]["exit_b"] == 0.0 and c["t"]["exit_a"] == 1e9, c["t"]
+    assert c["exited_before_traffic_b"] is True, c["exited_before_traffic_b"]
+    assert c["exited_before_traffic"] is False, c["exited_before_traffic"]
+
