{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "aneb-spec/schemas/result-run.schema.json",
  "title": "ANEB run.report_body 结果上报体",
  "description": "P1 客户端 /results 上报体(= Room report_body.body 原文)的 JSON Schema。锚定实况:生产者 app/probe/src/main/java/com/aneb/probe/engine/ResultReporter.kt,消费者 app/probe/src/main/java/com/aneb/probe/ui/ResultAqsBreakdown.kt 与 server/handlers_results.go(validateResultContract 只校验必填、不拒新增字段)。合同语义:未知字段容忍(additionalProperties: true——既有双端合同即容忍未知);可空字段=测量失败/未测/不可计算(R-10:null 绝不以 0/哨兵顶替)。spec schema_version 1.0.0。",
  "type": "object",
  "additionalProperties": true,
  "required": ["claim_scope", "kpi_set", "aqs_version", "profile_versions", "schema_version", "run", "scenarios"],
  "properties": {
    "claim_scope": {
      "const": "application_end_to_end_to_probe_node",
      "description": "表述边界锁定:终端至指定仿真节点的应用层路径(禁止表述为 MOS/无线层评级/运营商全网评级/SLA)"
    },
    "kpi_set": { "type": "string", "description": "KPI 门限集版本(TestRun.kpiSet,如 agent-qoe-kpi-v0.1)" },
    "aqs_version": { "type": "string", "description": "run 主分 AQS 版本(TestRun.aqsVersion,如 aqs-v0.1)" },
    "profile_versions": { "type": "string", "description": "本 run 各场景 profile 版本串(横比按此分组)" },
    "schema_version": {
      "type": "string",
      "description": "结果上报体 wire 合同版本(ResultReporter.SCHEMA_VERSION;当前 \"1.0\")。注意:独立于 spec 自身的语义化版本 1.0.0",
      "examples": ["1.0"]
    },
    "run": {
      "type": "object",
      "additionalProperties": true,
      "required": ["run_id", "started_at_epoch_ms", "mode", "scenario_order", "transport", "profile_source", "app_version_name", "app_version_code", "guard_metadata", "status", "aqs"],
      "properties": {
        "run_id": { "type": "string", "description": "UUIDv7(时间有序)" },
        "started_at_epoch_ms": { "type": "integer" },
        "mode": { "type": "string", "description": "quick / forensic" },
        "scenario_order": { "type": "string", "description": "实际执行顺序(拉丁方证据),如 \"s1,s2,s3|s2,s3,s1\"" },
        "transport": { "type": "string", "description": "auto / wifi / cellular" },
        "profile_source": { "type": "string", "description": "profiles 来源:server / assets_fallback" },
        "app_version_name": { "type": ["string", "null"] },
        "app_version_code": { "type": ["integer", "null"] },
        "guard_metadata": { "type": ["string", "null"], "description": "守卫元数据 JSON/KV 串" },
        "status": { "type": ["string", "null"], "description": "completed / aborted:<reason>" },
        "skipped_profiles": { "type": ["array", "null"], "items": { "type": "string" }, "description": "本次 run 里「配置上应跑却因 profile 缺失而被跳过」的 profile id 列表(D-534 §2/大脑 08-22 裁定)。动机:s4_throughput 缺 profile 时的跳过此前只打一行 PROFILE_WARN 日志——日志到不了分析层,产物里无从分辨「跑了」和「被跳过」。[]=明确零跳过;null/缺失=该 run 早于本字段上线(R-10:缺失≠空数组——不知道跳没跳,不是知道没跳)。非必填;数组为将来的可选相位留位,今天唯一生产者是 s4_throughput 分支" },
        "env": { "type": "object", "additionalProperties": false, "required": ["thermal_max_status", "thermal_polluting_event_count"], "properties": { "thermal_max_status": { "type": ["string", "null"], "enum": ["none", "light", "moderate", "severe", "critical", "emergency", "shutdown", null], "description": "run 全程热状态最大值(EnvMonitors thermalName 序数取 max);null=本 run 无热监控" }, "thermal_polluting_event_count": { "type": ["integer", "null"], "minimum": 0, "description": "污染级(SEVERE+;R-11 判定留在 EnvMonitors 的 polluting 布尔,摘要只计数不重判)热事件条数;null=无监控。与 thermal_max_status 同 null 同非 null(块内 required 钉两键恒在)" } }, "description": "run 级环境摘要(THERMAL 接线,D-556/普查 5e5dd67;同构先例 skipped_profiles/D-534)。块缺席=该 run 早于本字段上线(R-10:缺失≠空——不知道热不热,不是知道不热);块在而双键 null=本 run 无热监控(PowerManager 不可用/监听注册失败);\"none\"+0=监控在位且全程干净——0 是真实读数非 R-10 伪装(计数器语义同款)。非必填,纯 additive,老语料照常过" },
        "voice": { "type": "object", "additionalProperties": false, "required": ["caliber", "m7_max_frame_gap_ms", "mouth_ear_proxy_p50_ms", "low_confidence", "turns_ok", "ts_epoch_ms"], "properties": { "caliber": { "type": ["string", "null"], "description": "口径标注(voice_result.caliber 原样);null=v1 paced-proxy" }, "m7_max_frame_gap_ms": { "type": ["number", "null"], "minimum": 0, "description": "M7 最长帧间静默(max 非分位——P95 会把罕见但致命的长冻结整个丢掉,D-390 §5.6);null=被挂接行早于 M7 落地(不是没有静默,R-10)" }, "mouth_ear_proxy_p50_ms": { "type": ["number", "null"], "minimum": 0, "description": "M1\u0027 口到耳实测代理 P50(hero 指标);v1 行恒 null" }, "low_confidence": { "type": "boolean", "description": "上行入队背压出现过(v2 口径);v1 恒 false" }, "turns_ok": { "type": ["integer", "null"], "minimum": 0, "description": "protocol_ok 轮数(诚实对账);v1 行恒 null" }, "ts_epoch_ms": { "type": "integer", "minimum": 0, "description": "溯源:被挂接 voice_result 行的落库时刻(epoch ms);跨纪元比对/去重以它为准(D-513,id 随纪元重计)" } }, "description": "run 级 voice 摘要（additive，键可缺席=旧生产者）。仅供战役报告链并入与横幅计数；语音判读以设备库 voice_result 全表为权威通道（大脑 2026-08-22 裁定）——本摘要不得作判读源。——以上为 v3 拟稿逐字。挂接语义:run 收尾取 24h 窗内最近一条 Done 行(voice_result 只存 Done 样本;AqsV02Gate/D-26 同款先例),块缺席=窗内无 Done 行或 run 早于本字段上线(R-10:缺失≠空);块内六键恒在,各值按实体语义独立可空" },
        "aqs": {
          "type": "object",
          "additionalProperties": true,
          "required": ["score", "low_confidence", "veto_applied", "not_computable_reason", "input_mapping", "sub_scores"],
          "properties": {
            "score": { "type": ["number", "null"], "description": "0-100 主分(aqs-v0.1);不可计算 null,绝不 0(R-10)" },
            "low_confidence": { "type": "boolean" },
            "veto_applied": { "type": "boolean", "description": "T4>1% 一票否决已触发(封顶 54)" },
            "not_computable_reason": { "type": ["string", "null"], "description": "INVALID_SCENARIO:… / KPI_MISSING:…" },
            "input_mapping": { "type": "string", "description": "AqsInputMapper.MAPPING_DESCRIPTION(输入口径说明)" },
            "sub_scores": { "$ref": "#/definitions/subScores" }
          }
        },
        "aqs_v02": {
          "type": "object",
          "additionalProperties": true,
          "description": "v0.2 并列出分(D-26,additive;仅当 run 期有可用 continuity 数据时写入,含 C1/C2 子分)",
          "required": ["aqs_version", "score", "low_confidence", "veto_applied", "not_computable_reason", "sub_scores"],
          "properties": {
            "aqs_version": { "type": "string", "examples": ["aqs-v0.2"] },
            "score": { "type": ["number", "null"] },
            "low_confidence": { "type": "boolean" },
            "veto_applied": { "type": "boolean" },
            "not_computable_reason": { "type": ["string", "null"] },
            "sub_scores": { "$ref": "#/definitions/subScores" }
          }
        },
        "aqs_token": {
          "type": "object",
          "additionalProperties": true,
          "description": "Token 模式并列出分(D-29,additive;纯数据不落文案,facet4 结论由 UI 从落库子分派生,D-02 不重算)",
          "required": ["aqs_version", "score", "low_confidence", "veto_applied", "not_computable_reason", "weights_table_id", "s1_veto_applied", "sub_scores"],
          "properties": {
            "aqs_version": { "type": "string", "examples": ["aqs-token-v0.1"] },
            "score": { "type": ["number", "null"], "description": "D1 缺失期诚实 null + KPI_MISSING:D1(自愈合同)" },
            "low_confidence": { "type": "boolean" },
            "veto_applied": { "type": "boolean" },
            "not_computable_reason": { "type": ["string", "null"] },
            "weights_table_id": { "type": ["string", "null"], "description": "WEIGHTS_TOKEN_MM / WEIGHTS_TOKEN_TXT(见 spec/scoring/weights.yaml)" },
            "s1_veto_applied": { "type": "boolean", "description": "S1 软否决已触发(<0.95 封顶 70 / <0.90 封顶 54)" },
            "s1_session_success_rate": { "type": "number", "description": "S1 会话完成率(D-33 实测;无遍数据时整组 s1_* 字段缺席,R-10)" },
            "s1_rounds": { "type": "integer", "description": "S1 总轮次(轮=场景遍,D-33)" },
            "s1_low_confidence": { "type": "boolean", "description": "总轮次 < S1_MIN_ROUNDS(3) 时 true(R-29)" },
            "sub_scores": { "$ref": "#/definitions/subScores" },
            "workload": {
              "type": "object",
              "additionalProperties": true,
              "description": "工作量数值块(facet4 输入 A;冻结 phases 的确定性投影)",
              "required": ["uplink_bytes_per_round", "peak_to_mean_ratio", "downlink_media_bytes", "token_stream_len", "tool_loop_rounds", "has_think_pause", "short_context_multi_turn", "long_stream_or_continuous"],
              "properties": {
                "uplink_bytes_per_round": { "type": "integer" },
                "peak_to_mean_ratio": { "type": "number" },
                "downlink_media_bytes": { "type": "integer" },
                "token_stream_len": { "type": "integer" },
                "tool_loop_rounds": { "type": "integer" },
                "has_think_pause": { "type": "boolean" },
                "short_context_multi_turn": { "type": "boolean" },
                "long_stream_or_continuous": { "type": "boolean" }
              }
            }
          }
        }
      }
    },
    "scenarios": {
      "type": "array",
      "items": { "$ref": "#/definitions/scenario" }
    }
  },
  "definitions": {
    "subScores": {
      "type": "object",
      "description": "KPI id → 0-100 子分(不可计算 run 为空对象;展示层据此走不可计算/分级近似分支,绝不以 0 顶替)",
      "additionalProperties": { "type": "number" }
    },
    "scenario": {
      "type": "object",
      "additionalProperties": true,
      "required": ["profile_id", "profile_version", "repeat_index", "order_index", "validity", "invalid_reasons", "kpi", "clock", "network_snapshot", "parse", "buffering", "itl_histogram"],
      "properties": {
        "profile_id": { "type": "string" },
        "profile_version": { "type": "string" },
        "repeat_index": { "type": "integer", "description": "取证模式第几遍(0 起);快测恒 0" },
        "order_index": { "type": "integer", "description": "run 内执行序号(拉丁方实际顺序证据)" },
        "validity": {
          "type": "string",
          "enum": ["valid", "valid_low_confidence", "invalid"],
          "description": "三态有效性(invalid 场景 KPI 已被 gate 置 null)。小写为权威——生产者(ResultReporter)自始写小写,全部真实语料均小写;schema 曾写大写造成两个事实源各说各话(D-190 记账、试点报告附二点名),D-371 按「实况为准」对齐。大写取值=历史/合成侧漂移,前门记非致命 advisory 不拒收"
        },
        "invalid_reasons": { "type": "string", "description": "逗号分隔 InvalidReason 名称;空串=无" },
        "kpi": {
          "type": "object",
          "additionalProperties": true,
          "description": "KPI 值+分级(KpiGrading);值 null 时分级串亦 null(R-10)",
          "required": ["t1_ttft_ms", "t2_itl_p95_ms", "t3_stall_rate", "t4_severe_stall_rate", "n1_rtt_p50_ms", "n2_jitter_ms", "u1_goodput_mbps", "u2_tool_loop_p95_ms", "seq_gap_count", "seq_dup_count"],
          "properties": {
            "t1_ttft_ms": { "type": ["number", "null"] },
            "t1_grade": { "type": ["string", "null"] },
            "t2_itl_p95_ms": { "type": ["number", "null"], "description": "主口径:合帧组内只保留组首间隔" },
            "t2_grade": { "type": ["string", "null"] },
            "t2_itl_p95_incl_coalesced_ms": { "type": ["number", "null"] },
            "t3_stall_rate": { "type": ["number", "null"], "description": "主口径:不含 resume_latency(R-09)" },
            "t3_grade": { "type": ["string", "null"] },
            "t3_stall_rate_incl_resume": { "type": ["number", "null"] },
            "t4_severe_stall_rate": { "type": ["number", "null"], "description": "一票否决输入(>0.01 封顶 54)" },
            "t4_grade": { "type": ["string", "null"] },
            "t5_resume_p95_ms": { "type": ["number", "null"], "description": "诊断项,不进 AQS(5.1)" },
            "n1_rtt_p50_ms": { "type": ["number", "null"] },
            "n1_grade": { "type": ["string", "null"] },
            "n2_jitter_ms": { "type": ["number", "null"] },
            "n2_grade": { "type": ["string", "null"] },
            "u1_goodput_mbps": { "type": ["number", "null"], "description": "含慢启动主口径(2xx 有效 goodput)" },
            "u1_grade": { "type": ["string", "null"] },
            "u1_goodput_excl_slow_start_mbps": { "type": ["number", "null"] },
            "u2_tool_loop_p95_ms": { "type": ["number", "null"] },
            "u2_grade": { "type": ["string", "null"] },
            "d1_goodput_mbps": { "type": ["number", "null"], "description": "T47 批①(D-468/D-469)：下行 goodput(`/download` 无限速 2xx 口径，逐次取中位数)，additive、非 required" },
            "d1_grade": { "type": ["string", "null"] },
            "u3_goodput_mbps": { "type": ["number", "null"], "description": "T47 批③(D-468/D-469)：单流自适应窗口上行 goodput 探针主口径(含慢启动)，additive、非 required；诊断期不进 AQS" },
            "u3_grade": { "type": ["string", "null"], "description": "诊断期恒为 null（未接入打分，spec §8.4.4）" },
            "u3_goodput_excl_slow_start_mbps": { "type": ["number", "null"] },
            "u3_window_target_ms": { "type": ["integer", "null"] },
            "u3_window_actual_ms": { "type": ["number", "null"] },
            "u3_bytes_transferred": { "type": ["integer", "null"] },
            "u3_rtt_ref_ms_pre": { "type": ["number", "null"] },
            "u3_rtt_ref_ms_post": { "type": ["number", "null"] },
            "u3_rtt_drift_ratio": { "type": ["number", "null"], "description": "rtt_ref_ms_post / rtt_ref_ms_pre" },
            "u3_rtt_dominance_ratio": { "type": ["number", "null"], "description": "window_actual_ms / rtt_ref_ms_pre" },
            "u3_rtt_dominance_ok": { "type": ["boolean", "null"], "description": "null=该场景未跑 s4_throughput" },
            "u3_window_underrun": { "type": ["boolean", "null"], "description": "true=窗口在到点前就传完了(bytes 达上限且 window_actual_ms < window_target_ms)——「定长时间窗」的设计前提此时失效，spec §8.3.3 要求这类样本不得与正常的「窗口到点截断」样本混算。false=正常到点截断。null=该场景未跑 s4_throughput，或该 run 早于本字段上线(缺失≠false，R-10)。进契约的理由(D-534 §2)：它此前只折进 low_confidence 并打一条 ADAPTIVE_*_WINDOW 日志，而混算发生在分析层——分析层读 JSONL、永远看不到日志" },
            "d3_goodput_mbps": { "type": ["number", "null"], "description": "T47 批③(D-468/D-469)：单流自适应窗口下行 goodput 探针主口径(含慢启动)，additive、非 required；诊断期不进 AQS" },
            "d3_grade": { "type": ["string", "null"], "description": "诊断期恒为 null（未接入打分，spec §8.4.4）" },
            "d3_goodput_excl_slow_start_mbps": { "type": ["number", "null"] },
            "d3_window_target_ms": { "type": ["integer", "null"] },
            "d3_window_actual_ms": { "type": ["number", "null"] },
            "d3_bytes_transferred": { "type": ["integer", "null"] },
            "d3_rtt_ref_ms_pre": { "type": ["number", "null"] },
            "d3_rtt_ref_ms_post": { "type": ["number", "null"] },
            "d3_rtt_drift_ratio": { "type": ["number", "null"] },
            "d3_rtt_dominance_ratio": { "type": ["number", "null"] },
            "d3_window_underrun": { "type": ["boolean", "null"], "description": "下行方向的同一语义，见 u3_window_underrun" },
            "d3_rtt_dominance_ok": { "type": ["boolean", "null"], "description": "null=该场景未跑 s4_throughput" },
            "seq_gap_count": { "type": "integer" },
            "seq_dup_count": { "type": "integer" }
          }
        },
        "clock": {
          "type": "object",
          "additionalProperties": true,
          "required": ["offset_start_us", "offset_end_us", "drift_ppm", "offset_suspect"],
          "properties": {
            "offset_start_us": { "type": ["integer", "null"] },
            "offset_end_us": { "type": ["integer", "null"] },
            "drift_ppm": { "type": ["number", "null"] },
            "offset_suspect": { "type": "boolean", "description": "|drift|>100ppm 或首尾任一端缺失(保守置疑,R-22)" },
            "wall_skew_ms": { "type": ["integer", "null"], "description": "设备墙钟-服务端墙钟(ms,本场景非warmup样本中位)。与offset_*不同:那些是两个单调计数之差(R-24免疫墙钟),本字段才是钟指得对不对(T64 §8/D-506)。非必填:历史语料无此字段;旧服务端不回anchor时为null(R-10不记0)" }
          }
        },
        "network_snapshot": {
          "type": "object",
          "additionalProperties": true,
          "required": ["transport", "capabilities", "interface", "server_observed_addr"],
          "properties": {
            "transport": { "type": ["string", "null"] },
            "capabilities": { "type": ["string", "null"] },
            "interface": { "type": ["string", "null"] },
            "server_observed_addr": { "type": ["string", "null"], "description": "服务端观察到的客户端源 IP:port(路径对账)" },
            "radio": {
              "type": "object",
              "additionalProperties": false,
              "required": ["rat", "rsrp_dbm", "sinr_db", "pci", "tac", "arfcn", "sampled_n", "stale"],
              "description": "无线上下文(RADIO_CONTEXT_WIRING_SPEC v1.0):蜂窝场景才写,wifi 场景不写该键;任何不可得项写 null,严禁 0/-1/MAX_VALUE 哨兵(R-10)",
              "properties": {
                "rat": { "type": ["string", "null"], "description": "TelephonyManager.dataNetworkType 名称(NR/LTE/…)" },
                "rsrp_dbm": { "type": ["number", "null"], "description": "LTE RSRP / NR SS-RSRP,场景期间中位,dBm,值域 [-160,-30]" },
                "sinr_db": { "type": ["number", "null"], "description": "LTE RSSNR / NR SS-SINR,场景期间中位,dB,值域 [-30,45]" },
                "pci": { "type": ["integer", "null"], "description": "物理小区标识" },
                "tac": { "type": ["integer", "null"], "description": "跟踪区码" },
                "arfcn": { "type": ["integer", "null"], "description": "频点号(pci/tac/arfcn 合成服务小区标识,合成规则在分析层)" },
                "sampled_n": { "type": ["integer", "null"], "description": "两个中位数由几个读数得出(≥0)" },
                "stale": { "type": "boolean", "description": "是否超出采集侧新鲜度窗口(分析层排除并计数,不静默)" }
              }
            }
          }
        },
        "kpi_quality": {
          "type": "object",
          "description": "per-KPI 质量(D-373,可选/加性;v17+ 生产者写):键=KPI 短名(与设备侧 lowConfidenceKpis 同一词汇,T1/T2/T2_incl_coalesced/T3/T3_incl_resume/T4/T5/N1/N2/U1/U1_excl_slow_start/U2),值={sample_count:进入统计的有效样本数,low_confidence:该 KPI 是否低于其口径下限}。低置信判词由此带理由——此前契约只导结论,标记恒真且无从定位(试点报告附二)",
          "additionalProperties": {
            "type": "object",
            "required": ["sample_count", "low_confidence"],
            "properties": {
              "sample_count": { "type": ["integer", "null"] },
              "low_confidence": { "type": "boolean" }
            }
          }
        },
        "parse": {
          "type": "object",
          "additionalProperties": true,
          "required": ["parse_dur_us", "per_event_parse_us"],
          "properties": {
            "parse_dur_us": { "type": ["integer", "null"] },
            "per_event_parse_us": { "type": ["number", "null"] }
          }
        },
        "buffering": {
          "type": "object",
          "additionalProperties": true,
          "description": "批化标注(P1-C08;R-05:仅标注与取证证据,服务端/下游不得据此改判 validity;未检测全 null)",
          "required": ["score", "attribution", "sample_count"],
          "properties": {
            "score": { "type": ["number", "null"], "description": "连续批化分 [0,1]" },
            "attribution": { "type": ["string", "null"], "description": "none/airlink_suspect/middlebox_suspect/…(小写)" },
            "sample_count": { "type": ["integer", "null"] },
            "sawtooth_ratio": { "type": ["number", "null"] },
            "near_zero_arrival_ratio": { "type": ["number", "null"] },
            "lag1_autocorrelation": { "type": ["number", "null"] },
            "batch_count": { "type": ["integer", "null"] },
            "best_grid_us": { "type": ["integer", "null"] },
            "jank_overlap_ratio": { "type": ["number", "null"] }
          }
        },
        "itl_histogram": {
          "type": "object",
          "additionalProperties": true,
          "description": "ITL 对数分桶直方图(R-27 合同:桶界=对数网格 ∪ T2/T3/T4 门限锚点)",
          "required": ["buckets_version", "edges_ms", "counts", "total"],
          "properties": {
            "buckets_version": { "type": "string", "examples": ["log2-1..8192+thresholds-v1"] },
            "edges_ms": { "type": "array", "items": { "type": "number" } },
            "counts": { "type": "array", "items": { "type": "integer" }, "description": "长度 = edges_ms 长度 + 1(首尾开区间)" },
            "total": { "type": "integer" }
          }
        }
      }
    }
  }
}
